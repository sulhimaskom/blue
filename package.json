{
  "name": "architect-platform",
  "version": "1.0.0",
  "description": "AI-powered platform for generating software blueprints and repositories",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.less",
    "*.styl",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.webp",
    "*.ico",
    "*.woff",
    "*.woff2",
    "*.ttf",
    "*.eot"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fixed-build-232.js",
    "build:ci": "node scripts/ci-build-343.js",
    "build:fast": "NEXT_CONFIG_FILE=next.config.speed.js node scripts/ultra-fast-build-optimizer-v3.js",
    "build:standard": "NEXT_BUILD_WORKERS=4 NODE_OPTIONS='--max-old-space-size=4096' npx next build",
    "build:clean": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=4096' NEXT_BUILD_WORKERS=4 next build",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' next build",
    "dev:perf": "NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "dev:optimize": "node scripts/optimize-dev-performance.js",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --silent",
    "test:coverage": "jest --coverage --silent",
    "test:api": "jest --config=jest.api-integration.config.js",
    "test:api:coverage": "jest --config=jest.api-integration.config.js --coverage",
    "test:all": "npm run test && npm run test:api",
    "test:performance": "node scripts/test-performance-monitor.js",
    "test:build-performance": "node scripts/build-performance-monitor.js",
    "optimize-db": "node scripts/optimize-database.js",
    "infrastructure:check": "./scripts/infrastructure-health-monitor.sh",
    "migrate:up": "npx tsx migrations/0001_add_data_integrity_constraints.ts",
    "migrate:down": "npx tsx migrations/0001_add_data_integrity_constraints.ts down",
    "migrate:unique:up": "npx tsx migrations/0005_add_unique_constraints.ts",
    "migrate:unique:down": "npx tsx migrations/0005_add_unique_constraints.ts down",
    "migrate:timestamps:up": "npx tsx migrations/0006_add_updated_at_timestamps.ts",
    "migrate:timestamps:down": "npx tsx migrations/0006_add_updated_at_timestamps.ts down",
    "migrate:check:up": "npx tsx migrations/0007_add_check_constraints.ts up",
    "migrate:check:down": "npx tsx migrations/0007_add_check_constraints.ts down",
    "migrate:webhook:up": "npx tsx migrations/webhook-runner.ts",
    "migrate:webhook:down": "npx tsx migrations/webhook-runner.ts down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node migrations/drizzle-migrate.js",
    "db:rollback": "node migrations/drizzle-rollback.js",
    "db:status": "node migrations/drizzle-status.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.36.7",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/node": "^10.32.1",
    "@types/redis": "^4.0.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.33.0",
    "glob": "^11.0.0",
    "next": "^15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.10.0",
    "stripe": "^20.1.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@next/bundle-analyzer": "^16.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/stripe": "^8.0.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^1.0.0-beta.5-5707f0d",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
