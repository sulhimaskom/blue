{
  "name": "architect-platform",
  "version": "1.0.0",
  "description": "AI-powered platform for generating software blueprints and repositories",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_BUILD_WORKERS=1 NODE_OPTIONS='--max-old-space-size=8192 --expose-gc' npx next build --no-lint",
    "build:clean": "rm -rf .next && NODE_OPTIONS='--max-old-space-size=4096' NEXT_BUILD_WORKERS=4 next build",
    "build:analyze": "ANALYZE=true NODE_OPTIONS='--max-old-space-size=4096' next build",
    "dev:perf": "NODE_OPTIONS='--max-old-space-size=4096' next dev --turbo",
    "dev:optimize": "node scripts/optimize-dev-performance.js",
    "build:perf": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_BUILD_WORKERS=4 next build",
    "build:optimizer": "node scripts/build-optimizer.js",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' NEXT_BUILD_WORKERS=4 NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --silent",
    "test:coverage": "jest --coverage --silent",
    "test:api": "jest --config=jest.api-integration.config.js",
    "test:api:coverage": "jest --config=jest.api-integration.config.js --coverage",
    "test:all": "npm run test && npm run test:api",
    "optimize-db": "node scripts/optimize-database.js",
    "infrastructure:check": "node scripts/infrastructure-health-check.js",
    "infrastructure:recover": "node scripts/infrastructure-recovery.js",
    "infrastructure:report": "node scripts/infrastructure-report.js",
    "migrate:up": "npx tsx migrations/0001_add_data_integrity_constraints.ts",
    "migrate:down": "npx tsx migrations/0001_add_data_integrity_constraints.ts down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node migrations/drizzle-migrate.js",
    "db:rollback": "node migrations/drizzle-rollback.js",
    "db:status": "node migrations/drizzle-status.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.0.0",
    "@neondatabase/serverless": "^0.9.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.32.1",
    "@sentry/node": "^10.32.1",
    "@sentry/profiling-node": "^10.32.1",
    "@sentry/serverless": "^7.120.4",
    "@types/lodash": "^4.17.21",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.33.0",
    "lodash": "^4.17.21",
    "next": "^15.5.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^5.10.0",
    "stripe": "^17.3.0",
    "supertest": "^7.1.4",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@next/bundle-analyzer": "^16.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/stripe": "^8.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^1.0.0-beta.5-5707f0d",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
