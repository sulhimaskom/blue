# Database
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# Rate Limiting (Redis)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# AI Services
IFLOW_API_KEY="your_iflow_api_key"
IFLOW_BASE_URL="https://api.models.dev/v1"
TAVILY_API_KEY="your_tavily_api_key"

# Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Payments
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# GitHub (App Integration - Production)
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="789012"

# GitHub (Personal Access Token - Development/Backup)
GITHUB_ACCESS_TOKEN="ghp_..."

# Environment
NODE_ENV="development"

# Monitoring & Observability
# Sentry (Optional - for production error tracking)
# SENTRY_DSN="https://your-sentry-dsn"
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Performance Monitoring (Optional - for advanced analytics)
# DATADOG_API_KEY="your-datadog-api-key"
# NEW_RELIC_LICENSE_KEY="your-newrelic-license-key"

# Health & Monitoring System (Built-in)
# Note: Built-in monitoring automatically tracks:
# - API response times and error rates
# - AI operation performance (completion/research times)
# - GitHub service operation success/failure
# - Database and Redis connectivity health
# - System uptime and service availability